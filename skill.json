{
  "name": "postward-local-media-gen",
  "version": "0.1.0",
  "display_name": "Postward Local Media Generation",
  "description": "Hardware-aware local image, speech and video generation for Postward users.",
  "entrypoint": "SKILL.md",
  "install": "./bootstrap.sh",
  "doctor": "python scripts/doctor.py",
  "queue": "python scripts/job_queue.py",
  "supported_media": ["image", "video", "audio", "upscale"],
  "local_adapters": [
    "Stable Diffusion WebUI Forge (txt2img, img2img, masked inpaint)",
    "Lossless CPU masked image composition",
    "ComfyUI MiniMax H3",
    "VibeVoice 1.5B HF (local TTS)",
    "NVIDIA RTX Video Super Resolution"
  ],
  "image_generation": {
    "adapter": "forge_runtime",
    "install": "existing-forge-install-required",
    "operations": ["txt2img", "img2img", "inpaint"],
    "queue_command": "python scripts/forge_job.py",
    "mask_semantics": "white=editable, black=protected",
    "remote_uploads": false,
    "model_downloads": false,
    "gpu_lock": "comfyui-runtime/state/gpu.lock",
    "minimum_free_vram_mb_default": 4096
  },
  "image_composition": {
    "adapter": "forge_runtime.masked_composition",
    "command": "python scripts/compose_masked_edit.py",
    "gpu_required": false,
    "output_format": "PNG",
    "mask_semantics": "white=editable, black=protected, gray=blend",
    "feathering": "optional gaussian mask blur",
    "protected_pixels": "byte-for-byte equal outside nonzero mask pixels",
    "provenance": "sidecar manifest with source, edit, mask and output SHA-256"
  },
  "video_generation": {
    "adapter": "comfyui-runtime",
    "setup": "./bootstrap.sh",
    "comfyui_version": "v0.36.0",
    "comfyui_requirements_snapshot": "requirements-comfyui-v0.36.0.txt",
    "model_weights": "explicit-license-gated-download",
    "weight_command": "LICENSE_OK=1 ./comfyui-runtime/fetch_h3_weights.sh",
    "workflows": ["T2V", "I2V", "R2V template", "RTX VSR"],
    "queue_command": "python scripts/job_queue.py run",
    "gpu_lock": "comfyui-runtime/state/gpu.lock"
  },
  "audio_generation": {
    "adapter": "voice_runtime",
    "model_id": "vibevoice/VibeVoice-1.5B-hf",
    "install": "scripts/bootstrap_vibevoice.sh",
    "prepare_command": "VIBEVOICE_RESEARCH_OK=1 python voice_runtime/run.py prepare",
    "queue_command": "python scripts/vibevoice_job.py tts",
    "model_downloads": "explicit-only",
    "storage_default": "${XDG_DATA_HOME:-$HOME/.local/share}/postward/vibevoice",
    "gpu_lock": "comfyui-runtime/state/gpu.lock",
    "minimum_free_vram_mb": 5632,
    "voice_cloning_requires_explicit_recorded_consent": true,
    "supported_languages": ["English", "Chinese"],
    "portuguese": "unsupported; smoke test only"
  },
  "runtime": {
    "platform": "linux",
    "gpu": "nvidia-cuda",
    "environment_manager": "uv",
    "pinned_python": "3.12",
    "python": ">=3.11,<3.14",
    "python_source": "uv-managed; not the system interpreter",
    "own_dependencies": "requirements-core.txt",
    "lockfile": "requirements-comfyui.lock",
    "speech_lockfile": "requirements-vibevoice.lock",
    "relock_command": "./scripts/relock.sh",
    "lock_verification": "python scripts/doctor.py check-lock requirements-comfyui.lock",
    "cuda_build_tag": "cu128",
    "minimum_vram_gb": 8,
    "recommended_ram_gb": 32
  },
  "license_gate": {
    "h3_weights": "explicit-user-confirmation-required",
    "vibevoice_model": "research-and-development-only; acknowledgement-required",
    "command": "LICENSE_OK=1 ./comfyui-runtime/fetch_h3_weights.sh",
    "vibevoice_command": "VIBEVOICE_RESEARCH_OK=1 python voice_runtime/run.py prepare"
  },
  "tool_selection": {
    "order": ["repository-adapter", "installed-external-tool", "pinned-container-sidecar"],
    "hosted_services": "never",
    "one_engine_per_step": true,
    "discovery": "scripts/doctor.py external_tools reports available, path and version per tool",
    "mcp_servers": "listed by the harness; their binaries appear in external_tools"
  },
  "external_tools": {
    "probed_by": "scripts/doctor.py",
    "missing_tool_is_not_an_error": true,
    "ids": [
      "ffmpeg", "ffprobe", "imagemagick", "graphicsmagick", "libvips", "gmic",
      "openimageio", "gimp", "inkscape", "qpdf", "ghostscript", "darktable",
      "rawtherapee", "exiftool", "docker"
    ],
    "container_reference": "reference/docker-sidecars.md"
  },
  "concurrency": {
    "gpu_inference_jobs": 1,
    "queue": "python scripts/job_queue.py"
  }
}
